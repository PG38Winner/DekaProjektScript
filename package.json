{
  "name": "dekaprojekt-anonymizer",
  "version": "1.0.0",
  "description": "Ersetzt personenbezogene Daten in Excel-Dateien und Access-Datenbanken durch erfundene Werte (Maskierung)",
  "type": "module",
  "bin": {
    "maskieren": "src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js",
    "build": "esbuild src/cli.js --bundle --platform=node --target=node20 --format=cjs --outfile=dist/maskierer.cjs",
    "test": "node --test test/*.test.js",
    "check": "node --check src/cli.js && node --test test/*.test.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PG38Winner/DekaProjektScript.git"
  },
  "license": "ISC",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@faker-js/faker": "^10.5.0",
    "exceljs": "^4.4.0",
    "jszip": "^3.10.1",
    "mdb-reader": "^3.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
